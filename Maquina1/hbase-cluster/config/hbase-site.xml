<?xml version="1.0"?>
<configuration>
  <!-- Força o HBase a rodar em modo local/solo estável dentro do container -->
  <property>
    <name>hbase.cluster.distributed</name>
    <value>True</value>
  </property>

  <!-- Define o diretório de armazenamento local estável do container -->
  <property>
    <name>hbase.rootdir</name>
    <value>file:///data/hbase</value>
  </property>

  <!-- Cria tabelas automaticamente sob demanda no importador -->
  <property>
    <name>hbase.util.table.create.on.demand</name>
    <value>true</value>
  </property>
  <!-- Raiz de armazenamento apontando para o NameNode distribuído -->
  <property>
    <name>hbase.rootdir</name>
    <value>hdfs://maquina1:8020/hbase</value>
  </property>

  <!-- Quorum de coordenação unificado com os 3 nós da rede -->
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>100.80.31.21,100.76.200.127,100.122.222.2</value>
  </property>
</configuration>
